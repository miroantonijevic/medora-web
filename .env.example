# Local development: app on host, database in Docker exposed on 5432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/medora-web

# Production in Docker Compose: host is the postgres service name
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/medora-web

# Required secrets
PAYLOAD_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret

# Used by preview / live preview endpoints
PREVIEW_SECRET=replace-with-a-strong-random-secret

# Used by the /next/revalidate webhook (called by Payload afterChange hooks)
REVALIDATE_SECRET=replace-with-a-strong-random-secret

# Public app URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Docker Compose / nginx production ---
# Your public domain (used by nginx SSL cert paths and Certbot)
DOMAIN=example.com
# Email for Let's Encrypt certificate registration
CERTBOT_EMAIL=admin@example.com
# PostgreSQL credentials (overrides the defaults in docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-secret
POSTGRES_DB=medora-web
